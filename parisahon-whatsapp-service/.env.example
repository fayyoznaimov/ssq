# parisahon-whatsapp-service. Copy to .env (or an EnvironmentFile of the unit) and fill in.

# HTTP API for the CRM API (bind to localhost: only the API calls it)
HOST=127.0.0.1
PORT=3140

# The CRM API: incoming messages go to ${CRM_API_URL}/whatsapp/incoming
CRM_API_URL=http://127.0.0.1:3000/api/v1
# Shared secret, the same as WHATSAPP_SERVICE_TOKEN of the API. Sent and expected in the header
# X-WhatsApp-Service-Token. Generate: openssl rand -hex 24
CRM_API_TOKEN=
CRM_API_TIMEOUT_SEC=30

# One encrypted file per manager (Baileys creds + signal keys) and the outbox. Mode 700 / 600.
SESSIONS_DIR=./sessions
# 32 bytes in base64: openssl rand -base64 32. Without it sessions are stored as plain text (dev only).
# Losing or changing it = every manager scans the QR again.
SESSION_ENCRYPTION_KEY=

# The API's uploads folder (parisahon-api/public/uploads): received media are saved here,
# files for POST /send are read from here.
UPLOADS_DIR=../parisahon-api/public/uploads
# Static ffmpeg: voice messages (ogg/opus) -> mp3 and video thumbnails. Empty = voice stays .ogg.
FFMPEG_BIN=
# Larger files are not downloaded; a note goes into the message text instead.
MAX_FILE_MB=50

# Outbox retry: every POLL_SEC, the pause doubles after each failure up to MAX_BACKOFF_SEC
POLL_SEC=10
MAX_BACKOFF_SEC=300

# POST /sessions/:id/start waits this long for the first QR; a QR session not finished in
# QR_TIMEOUT_SEC stops (status none)
START_WAIT_SEC=10
QR_TIMEOUT_SEC=180
# POST /send answers 504 {pending} after this (the CRM API waits 120 s); the send goes on and the service
# records it in the CRM when WhatsApp took it
SEND_WAIT_SEC=90
# on SIGTERM the messages in hand are handled for at most this long (the rest stay in inbox.json)
DRAIN_SEC=8

# trace|debug|info|warn|error. Baileys below "warn" is very talkative.
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
# Fixed WhatsApp Web version "2,3000,1055357543"; empty = asked from web.whatsapp.com at start
WA_VERSION=
# The companion shown in Linked devices and sent with pairing codes: Chrome on ubuntu | macos | windows
WA_BROWSER=ubuntu
