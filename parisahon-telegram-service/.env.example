PORT=3030
HOST="0.0.0.0"

# The CRM API: every message goes to POST /telegram/incoming with this shared token
# (TELEGRAM_SERVICE_TOKEN in the API's .env). 32+ random characters.
CRM_API_URL=http://crm-app:3000/api/v1
CRM_API_TOKEN=
CRM_API_TIMEOUT=30

# sqlite with the Telegram sessions of the managers and the outbox of undelivered messages
SERVICE_DB=telegram_service.db
# key that encrypts the managers' Telegram sessions in that file (a session = full access
# to the account). Generate once and keep: without it the sessions cannot be read and the
# managers have to connect Telegram again. See helpers/session_crypto.py.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
LOGS_DIR=logs
# seconds: new sessions, outbox retry, call recordings
POLL_SEC=3
SESSION_RETRY_SEC=300
# seconds the CRM waits for Telegram to accept a message sent from a deal
SEND_TIMEOUT_SEC=60

# No direct database access any more: call recordings from the folders go to POST /calls/upload too.

DEAL_STAGE_CLOSED="УСПЕШНО РЕАЛИЗОВАНО"
DEAL_STAGE_CLOSED_NOT_REALIZED="ЗАКРЫТО И НЕ РЕАЛИЗОВАНО"
DEAL_STAGE_UNKNOWN="НЕРАЗОБРАННОЕ"

FFMPEG_INSTALLATION_DIR="/app/ffmpeg-6.1-amd64-static" # if you want manual installation
USE_CUSTOM_FFMPEG_INSTALLATION=false
RECORDINGS_SOURCE="/app/recordings"
# downloaded Telegram media and converted recordings: parisahon-api/public/uploads
RECORDINGS_TARGET="/app/uploads"
