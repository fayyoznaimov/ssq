APP_PORT=3000
APP_ENV="LOCAL" # LOCAL, DEV, PROD
SSL_KEY_PATH="/app/keys"
# The CRM's time zone, one setting: the API, its database sessions and the database default (migration
# 1795720000000-database-time-zone). Empty or unknown: Asia/Tashkent (src/helper/time-zone.ts)
TZ=Asia/Tashkent

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=parisahon
POSTGRES_USER=root
POSTGRES_PASSWORD=passwd

TYPEORM_MIGRATIONS="dist/migrations/*.js"
TYPEORM_ENTITIES="dist/**/*.entity.js"
TYPEORM_SYNCHRONIZE=false

JWT_SECRET=someRandomSecret
# Links to uploaded files (/uploads/<name>) are signed and expire after 12 hours (src/file/file-link.ts).
# FILE_LINK_SECRET: the HMAC key (empty: derived from JWT_SECRET). FILE_LINK_ENFORCE: 1 refuses a file
# without a valid signature (403); 0 (default, for the switch-over) serves it and logs it.
FILE_LINK_SECRET=
FILE_LINK_ENFORCE=0
HASH_SECRET=someOtherRandomSecret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@gmail.com

# The meaning of a stage is deal_stage.kind (new, first_contact, prepayment, won, lost, work):
# src/deal_stage/stage-kind.ts. DEAL_STAGE_* are only the default names of the system stages of a new
# pipeline, and, for one release (fallback, to be removed), the names by which migration
# 1795620000000-deal-stage-kind and the start of the API give a kind to the old stages.
DEAL_STAGE_CREATED="ПЕРВИЧНЫЙ КОНТАКТ"
DEAL_STAGE_CLOSED="УСПЕШНО РЕАЛИЗОВАНО"
DEAL_STAGE_CLOSED_NOT_REALIZED="ЗАКРЫТО И НЕ РЕАЛИЗОВАНО"
DEAL_STAGE_PREPAYMENT="ПРЕДОПЛАТА"
DEAL_STAGE_UNKNOWN="НЕРАЗОБРАННОЕ"
DEAL_STAGES_IN_BETWEEN=

DEFAULT_COLLECTION_NAME="Воронка"

EMAIL_HOST="parisahome.com"
EMAIL_DEFAULT_USER="testing@parisahome.com"
EMAIL_DEFAULT_PASSWORD=
EMAIL_MAIN_MAILBOX="INBOX"
EMAIL_SPAM_MAILBOX="INBOX.spam"
EMAIL_TRASH_MAILBOX="INBOX.Trash"
EMAIL_SENT_MAILBOX="INBOX.Sent"

EMAIL_IMAP_PORT=993
EMAIL_SMTP_PORT=

TELEGRAM_SERVICE_HOST="http://telegram-app"
TELEGRAM_SERVICE_PORT=3030
# Shared secret of parisahon-telegram-service (its CRM_API_TOKEN), 32+ random characters
TELEGRAM_SERVICE_TOKEN=
# The token the API sends to the service's own HTTP API (X-Telegram-Service-Token, its SERVICE_HTTP_TOKEN);
# empty = TELEGRAM_SERVICE_TOKEN, so the same shared secret works both ways without a change
TELEGRAM_SERVICE_HTTP_TOKEN=
# Telegram application keys from my.telegram.org (were in the public frontend config before)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# true: ignore chats with people who are not contacts in the CRM (Telegram and WhatsApp). Only the
# default now: each manager sets «Только известные контакты» on the Telegram / WhatsApp page
TELEGRAM_KNOWN_CONTACTS_ONLY=false
# Managers' Telegram / WhatsApp (src/messenger): how often the API asks both services whether the
# sessions work and tells a manager in the CRM bot that his broke (seconds, 0 = off); a message goes to
# another manager's open deal only when something happened in it within N days and that manager is still
# a staff user; a client's message within N hours after his deal was closed goes there (with a task)
MESSENGER_HEALTH_SEC=300
MESSENGER_FOREIGN_DEAL_DAYS=30
MESSENGER_AFTER_CLOSE_HOURS=24
# Deal-stage triggers: scheduler period in seconds (0 = off)
TRIGGER_SCHEDULER_SEC=30
# Deal-stage triggers, limits: runs of one trigger for one deal in 24 h (letters of «Отправить письмо»
# separately); a letter older than N hours does not fire «при письме» (the first sync of a mailbox brings
# years of mail); the history of runs is kept N days (skipped runs less); failed runs are told to the
# admins in the CRM bot (0 = not)
TRIGGER_MAX_RUNS_PER_DEAL_DAY=50
TRIGGER_MAX_EMAILS_PER_DEAL_DAY=5
TRIGGER_EMAIL_MAX_AGE_HOURS=24
TRIGGER_RUNS_KEEP_DAYS=90
TRIGGER_SKIPPED_KEEP_DAYS=30
TRIGGER_FAIL_NOTIFY=1
# Deal-stage triggers: the deadline of a task «сразу» in minutes (it is never overdue as soon as it appears)
TRIGGER_TASK_MIN_MINUTES=30
# Call recordings (POST /calls/upload): path to ffmpeg (a static build is fine) and the queue period in seconds (0 = off)
FFMPEG_BIN=ffmpeg
CALLS_SCHEDULER_SEC=30
# The FTP receiver of call recordings (parisahon-ftp; local/deploy.sh ftp writes both):
# the secret it uploads with (X-Calls-Service-Token) and its address shown in Settings -> Calls.
CALLS_SERVICE_TOKEN=
CALLS_FTP_ADDRESS=
# CRM Telegram bot, voice messages: address of the speech-to-text service parisahon-stt (empty = voice
# messages off), its token if it runs with STT_TOKEN, the wait for one transcription and the longest voice (seconds)
CRM_BOT_STT_URL=http://127.0.0.1:8097
CRM_BOT_STT_TOKEN=
CRM_BOT_STT_TIMEOUT_SEC=150
CRM_BOT_VOICE_MAX_SEC=180

# WhatsApp of the managers (parisahon-whatsapp-service, QR like WhatsApp Web)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3140
# shared secret with the service (CRM_API_TOKEN there), 32+ random characters
WHATSAPP_SERVICE_TOKEN=

# AI of the CRM (src/ai, docs: src/ai/ai.config.ts). Runs through the server's Claude CLI (CLAUDE_BIN, the company's
# claude.ai login; at most CLAUDE_MAX_PARALLEL=2 processes for the whole CRM, one is always left for people).
# AI_FEATURES=1 turns it on (default off: no worker, the deal page says «выключено»). Then, per feature:
#   AI_TURNS=1           «Разбор хода»: the client wrote and the manager answered -> questions, promises, order params, flags
#   AI_SUMMARY=1         «Сводка сделки»: the button on the deal page and the bot tool deal_summary
#   AI_QUESTION_TASKS=0  unanswered questions become a task after AI_QUESTION_SLA_MIN working minutes (0 = shown only)
#   AI_PROMISE_TASKS=0   the manager's promises with a date become tasks, AI_PROMISE_TASKS_PER_DAY per deal (0 = shown only)
# The subscription's usage limit is shared with people: background analysis has a budget of CLI calls a day
# (AI_DAILY_BUDGET, 0 = no background AI); a usage limit reported by the CLI pauses all AI for AI_LIMIT_PAUSE_MIN,
# a CLI that does not work at all for AI_UNAVAILABLE_PAUSE_MIN. A summary costs a call only when the deal changed;
# a person may ask AI_INTERACTIVE_PER_HOUR new ones an hour. AI_MODEL: the CLI model (default CLAUDE_RECOGNITION_MODEL,
# a cheaper one such as the CLI's "sonnet" saves the limit), AI_EFFORT: its effort (low).
# AI_TEST_DEAL_PREFIX: test stands only (the background AI looks only at deals named so); empty in production.
AI_FEATURES=0
AI_TURNS=1
AI_SUMMARY=1
AI_QUESTION_TASKS=0
AI_PROMISE_TASKS=0
AI_DAILY_BUDGET=150
AI_WORKER_SEC=30
AI_TURN_QUIET_MIN=10
AI_QUESTION_SLA_MIN=30
AI_PROMISE_TASKS_PER_DAY=2
AI_LIMIT_PAUSE_MIN=60
AI_UNAVAILABLE_PAUSE_MIN=15
AI_MAX_ATTEMPTS=3
AI_INTERACTIVE_PER_HOUR=30
# how long the «Обновить» button / the bot tool wait for a summary before answering «готовится» (seconds)
AI_SUMMARY_WAIT_SEC=50
AI_BOT_WAIT_SEC=40
AI_TIMEOUT_SEC=120
AI_ACTIVE_DAYS=30
AI_JOBS_KEEP_DAYS=180
AI_MODEL=
AI_EFFORT=low
AI_TEST_DEAL_PREFIX=

# More AI on the same queue, budget and pause (src/ai-insights, docs: src/ai-insights/ai-insights.config.ts). Nothing
# works while AI_FEATURES=0; nothing here writes to a client or makes a task.
#   AI_MARKET=1          «Рынок» (Аналитика → Рынок): the client's words about other suppliers' prices and terms, taken
#                        out of the turns with «конкурент» / «дорого» / «скидка» or a target price (one background call
#                        per such turn, turns of the last AI_MARKET_DAYS), and the AI summary on demand. Our prices are in
#                        AI_MARKET_CURRENCY; prices in other currencies are compared only with a rate in AI_MARKET_RATES
#                        ("USD=12800,EUR=13900": how much of our currency one unit costs).
#   AI_INBOUND=0         «Разбор нового обращения»: the first message of a new contact -> заявка / клиент / поставщик /
#                        личное / спам / другое, country, client type, language, «что хочет клиент»; a note in the deal
#                        history (AI_INBOUND_NOTE) and the responsible manager told in the bot (AI_INBOUND_NOTIFY);
#                        nothing is deleted: «не заявки» are listed on the control page for the owner. A deal created
#                        within AI_INBOUND_HOURS, read AI_INBOUND_WAIT_MIN after the first message (or when answered).
#   AI_DIGEST_MORNING=0  at AI_DIGEST_MORNING_AT to everybody who linked the bot: waiting clients, promises of today,
#                        overdue tasks (no AI call). AI_DIGEST_EVENING=0: at AI_DIGEST_EVENING_AT to admins and
#                        managers: the day's numbers and five lines «что важно» by the AI (one call a day; without them
#                        after AI_DIGEST_EVENING_WAIT_MIN). Working days only (CONTROL_WORK_DAYS), within
#                        AI_DIGEST_WINDOW_MIN after their time, once a day per employee.
#   AI_LOST_REASON=1     the reason form of a lost deal: the AI proposes a reason of the list with the client's words
#                        (a person's request, AI_INTERACTIVE_PER_HOUR; the form waits AI_LOST_WAIT_SEC); the manager confirms.
#   AI_SUPERVISOR=0      at night (AI_SUPERVISOR_AT .. 07:00) the dialogs of the past AI_SUPERVISOR_DAYS days are reviewed
#                        against the checklist, at most AI_SUPERVISOR_MAX a night: «Качество диалогов» on the control
#                        page (advisory, not part of any rating); AI_SUPERVISOR_TIPS=1: once a week
#                        (AI_SUPERVISOR_TIPS_DAY, 1 = Monday, at AI_SUPERVISOR_TIPS_AT) «3 ошибки и как сказать лучше» in the bot.
# AI_INSIGHTS_TEST_PREFIX: test stands only (default there: AI_TEST_DEAL_PREFIX + "i2-"); empty in production.
AI_MARKET=1
AI_MARKET_DAYS=60
AI_MARKET_CURRENCY=UZS
AI_MARKET_RATES=
AI_INBOUND=0
AI_INBOUND_NOTE=1
AI_INBOUND_NOTIFY=1
AI_INBOUND_HOURS=24
AI_INBOUND_WAIT_MIN=3
AI_DIGEST_MORNING=0
AI_DIGEST_MORNING_AT=08:30
AI_DIGEST_EVENING=0
AI_DIGEST_EVENING_AT=18:30
AI_DIGEST_EVENING_WAIT_MIN=20
AI_DIGEST_WINDOW_MIN=180
AI_LOST_REASON=1
AI_LOST_WAIT_SEC=25
AI_SUPERVISOR=0
AI_SUPERVISOR_AT=01:00
AI_SUPERVISOR_MAX=40
AI_SUPERVISOR_DAYS=3
AI_SUPERVISOR_TIPS=1
AI_SUPERVISOR_TIPS_DAY=1
AI_SUPERVISOR_TIPS_AT=09:30
AI_INSIGHTS_TEST_PREFIX=

# The journal «кто что изменил» (src/audit): who changed what, when and from where (web, bot, trigger,
# autopilot, Telegram, WhatsApp, FTP, AI, mail), written in the transaction of the change; the logins too.
# AUDIT_LOG=0 switches the recording off (the CRM works as before, the journal just stops growing).
AUDIT_LOG=1
# rows older than this many days are removed every night at 03:40 (0 keeps everything); the baseline stays
AUDIT_RETENTION_DAYS=1095
