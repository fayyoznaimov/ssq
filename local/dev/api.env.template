# Dev copy of the CRM API on the server (next to the trial copy in ~/parisa-crm).
# Same keys as local/api.env, but: own database parisahon_dev on the trial Postgres,
# own port 3100, stubs on 127.0.0.1, dev-only secrets. Nothing here is a prod secret.
# This is the template: local/dev/setup.sh fills the __PLACEHOLDERS__ into local/dev/api.env (not in git).
# How to run: see local/dev/README.md and docs/AUDIT.md.
APP_PORT=3100
APP_LISTEN_PORT=3100
APP_ENV=DEV
SSL_KEY_PATH=/home/parisahome/parisahome-crm/parisahon-api/keys
TZ=Asia/Karachi

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55434
POSTGRES_DATABASE=parisahon_dev
POSTGRES_USER=crm
# filled in by local/dev/setup.sh from ~/parisa-crm/db.pass
POSTGRES_PASSWORD=__DBPASS__

TYPEORM_MIGRATIONS=dist/migrations/*.js
TYPEORM_ENTITIES=dist/**/*.entity.js
TYPEORM_SYNCHRONIZE=false

JWT_SECRET=__JWT_SECRET__
HASH_SECRET=__HASH_SECRET__

ADMIN_USERNAME=admin
ADMIN_PASSWORD=__ADMIN_PASSWORD__
ADMIN_EMAIL=admin@gmail.com

# Business constants, copied from prod (seeding matches stages by these names)
DEAL_STAGE_CREATED="ПЕРВИЧНЫЙ КОНТАКТ"
DEAL_STAGE_CLOSED="УСПЕШНО РЕАЛИЗОВАНО"
DEAL_STAGE_CLOSED_NOT_REALIZED="ЗАКРЫТО И НЕ РЕАЛИЗОВАНО"
DEAL_STAGE_PREPAYMENT="ПРЕДОПЛАТА"
DEAL_STAGE_UNKNOWN="НЕРАЗОБРАННОЕ"
DEAL_STAGES_IN_BETWEEN=
DEFAULT_COLLECTION_NAME="Воронка"
EMAIL_MAIN_MAILBOX="INBOX"
EMAIL_SPAM_MAILBOX="INBOX.spam"
EMAIL_TRASH_MAILBOX="INBOX.Trash"
EMAIL_SENT_MAILBOX="INBOX.Sent"

# Mail: the stand-in local/dev/mail/server.py (unit crm-dev-mail): IMAPS 8993, SMTPS 8465, self-signed
EMAIL_HOST=127.0.0.1
EMAIL_DEFAULT_USER=testing@parisahome.com
EMAIL_DEFAULT_PASSWORD=__MAIL_PASSWORD__
EMAIL_IMAP_PORT=8993
EMAIL_SMTP_PORT=8465
# the stand-in has a self-signed certificate
NODE_TLS_REJECT_UNAUTHORIZED=0

# Telegram service: the dev copy on this machine
TELEGRAM_SERVICE_HOST=http://127.0.0.1
TELEGRAM_SERVICE_PORT=3130
# Telegram of the managers: the dev copy of parisahon-telegram-service (unit crm-dev-telegram,
# no real Telegram sessions) and the shared secret for its POST /telegram/incoming
TELEGRAM_SERVICE_TOKEN=__TELEGRAM_SERVICE_TOKEN__
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_KNOWN_CONTACTS_ONLY=false

# Card recognition: the stand-in script answers instead of the Claude CLI. RECOGNITION_PROVIDER=api uses ANTHROPIC_API_KEY.
RECOGNITION_PROVIDER=claude
CLAUDE_BIN=/home/parisahome/parisahome-crm/local/fake-claude/claude
CLAUDE_RECOGNITION_MODEL=claude-opus-5-5
# A dummy on purpose: recognition_check proves it never reaches the Claude CLI
ANTHROPIC_API_KEY=test-key-not-real

# CRM Telegram bot: the stand-in Bot API (local/fake-telegram on 127.0.0.1:8098), never the real Telegram.
CRM_BOT_TOKEN=local-test-token
CRM_BOT_API_BASE=http://127.0.0.1:8098
CRM_PUBLIC_URL=http://172.0.30.4:4150
CRM_BOT_MODEL=claude-opus-5-5
CRM_BOT_EFFORT=medium
# fast reminder loop and a digest at any hour, for local/checks/bot_check.py
CRM_BOT_REMINDER_SEC=3
CRM_BOT_DIGEST_HOUR=0
CRM_BOT_DIGEST_WINDOW_H=24

# Voice messages of the bot: speech-to-text service parisahon-stt (unit crm-dev-stt: faster-whisper on 127.0.0.1:8097,
# test hooks on). Empty URL = voice messages off. Token only if the service has STT_TOKEN. Longest voice: 3 minutes.
CRM_BOT_STT_URL=http://127.0.0.1:8097
CRM_BOT_STT_TOKEN=
CRM_BOT_STT_TIMEOUT_SEC=150
CRM_BOT_VOICE_MAX_SEC=180

# Deal-stage triggers: how often the scheduler runs the due trigger_run rows (seconds; prod default 30)
TRIGGER_SCHEDULER_SEC=3

# Call recordings through the API: ffmpeg (static binary extracted from parisahon-telegram-service/ffmpeg) and the queue period
FFMPEG_BIN=/home/parisahome/parisahome-crm/local/dev/bin/ffmpeg
CALLS_SCHEDULER_SEC=3

# WhatsApp of the managers (parisahon-whatsapp-service, QR like WhatsApp Web)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3140
# shared secret with the service (CRM_API_TOKEN there), 32+ random characters
WHATSAPP_SERVICE_TOKEN=
